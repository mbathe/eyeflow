# Test Environment Configuration
NODE_ENV=test

# Database - Use SQLite in-memory for testing
DATABASE_HOST=:memory:
DATABASE_PORT=3306
DATABASE_USER=test
DATABASE_PASSWORD=test
DATABASE_NAME=:memory:
DATABASE_TYPE=better-sqlite3
DATABASE_SYNCHRONIZE=true

# Disable Kafka for testing
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eyeflow-test

# JWT
JWT_SECRET=test-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (disabled in test)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email (disabled in test — NODE_ENV=test suppresses sending)
MAIL_ENABLED=false
MAIL_FROM=noreply@eyeflow.io
APP_URL=http://localhost:3000

# LLM Configuration (disabled for testing)
OPENAI_API_KEY=test-key
OPENAI_MODEL=gpt-4

# Agent Configuration
AGENT_API_URL=http://localhost:5000
AGENT_API_KEY=test-key

# Logging
LOG_LEVEL=error
